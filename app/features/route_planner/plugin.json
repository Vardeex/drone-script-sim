{
  "id": "route_planner",
  "name": "Planer trasy",
  "version": "1.0.0",
  "description": "Planowanie trasy z punktów, podgląd, kontrola kolizji i generowanie skryptu",
  "author": "Vardeex",
  "requires_app": ">=1.0.0",
  "requires": ["obstacles"],
  "extension_points": ["api", "ui.panel", "ui.scene_layer", "ui.styles", "flight.analyse", "run.options"],
  "enabled": true,
  "api_prefix": "/api/route_planner",
  "static": "static/js/features/route_planner",
  "ui": {
    "panel": "static/js/features/route_planner/panel.js",
    "scene_layer": "static/js/features/route_planner/scene_layer.js",
    "styles": ["static/css/features/route_planner.css"],
    "tab": "tab-route",
    "tab_button": "tab-btn-route"
  }
}
