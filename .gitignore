# Środowisko lokalne
.venv/
tools/
cache/
tmp/

# Wyniki lotów (dane runtime, w tym wgrane skrypty i katalogi robocze _work)
flights/

# Sceny użytkownika (przykładowe sceny w scenes/*.json są w repo)
scenes/user/

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.pytest_cache/

# Konfiguracja lokalna / sekrety
.env
.env.*

# Zdjęcia referencyjne (materiały z internetu - nie publikujemy ze względu na prawa autorskie)
docs/ref/

# Edytory / system
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.log

# Raport sesji bez nadzoru (dokument roboczy, nie publikujemy)
RAPORT_SESJI.md

# Wtyczki zewnętrzne użytkownika (poza wzorem example_hello i opisem)
plugins/*
!plugins/README.md
!plugins/example_hello/

# Paczki dystrybucyjne biblioteki
lib/dronemoves/dist/
lib/dronemoves/build/

